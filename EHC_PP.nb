        RowBox[{"P", ",", 
         RowBox[{"-", "0.0001"}], ",", "100"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "100"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"dv", ",", "0.001", ",", "0.14"}], "}"}], ",", 
       RowBox[{"{", 
