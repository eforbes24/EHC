Cell[BoxData[{
 RowBox[{
  RowBox[{"PP", " ", "=", " ", 
   RowBox[{"DynamicalSystem", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "*", "V", "*", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           FractionBox["V", "kv"]}], ")"}]}], "-", 
        RowBox[{
         RowBox[{"(", 
          FractionBox["fvp", 
           RowBox[{"hvp", "+", " ", "V"}]], ")"}], "*", "V", "*", "P"}], " ", 
        "-", " ", 
        RowBox[{"dv", " ", "V"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          FractionBox[
           RowBox[{"yv", " ", "ep"}], "yp"], ")"}], "*", 
         RowBox[{"(", 
          FractionBox[
           RowBox[{"fvp", " "}], 
           RowBox[{"hvp", "+", " ", "V"}]], ")"}], "*", "V", "*", "P"}], " ", 
        "-", " ", 
        RowBox[{"dp", "*", "P"}]}]}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"V", ",", 
         RowBox[{"-", "0.0001"}], ",", "1000"}], "}"}], ",", 
