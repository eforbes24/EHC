Cell["Invert Density Dependence", "Subsubsection",
 CellChangeTimes->{{3.9811995511506653`*^9, 
  3.981199561266159*^9}},ExpressionUUID->"755aec60-71d0-934d-8857-\
982f00ecca7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IDD", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"dV", "/", "V"}], ",", "V"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.970578544523526*^9, 3.970578563604113*^9}},
 CellLabel->
  "In[163]:=",ExpressionUUID->"f1a1b2c9-2f67-4455-b58a-69dc1cc4bc3c"],

Cell[CellGroupData[{

Cell[BoxData["IDD"], "Input",
 CellChangeTimes->{{3.972991778274819*^9, 3.972991778496077*^9}},
 CellLabel->
  "In[164]:=",ExpressionUUID->"9a6011b3-7db8-468d-9386-186d2c5b98ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["r", "kv"]}], "+", 
  FractionBox[
   RowBox[{"fvp", " ", "P", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["V", "M"], ")"}], "\[Omega]"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"V", " ", 
