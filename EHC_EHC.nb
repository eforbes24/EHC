Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"i", ",", "j", ",", "l"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", 
    RowBox[{"(", 
     RowBox[{"min", "/", "gran"}], ")"}]}], ",", 
   RowBox[{"i", "<=", 
    RowBox[{"(", 
     RowBox[{"max", "/", "gran"}], ")"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "Transient", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DisplayTrajectories", "[", 
     RowBox[{
      RowBox[{"EDIB", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kz", "->", "200"}], ",", 
         RowBox[{"\[Omega]", "->", 
          RowBox[{"i", "*", "gran"}]}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"58.64", ",", "0.036", ",", "49.99", ",", "42.196"}], "}"}], 
       "}"}], ",", "200000", ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", "Simulation", " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"DisplayTrajectories", "[", 
     RowBox[{
      RowBox[{"EDIB", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kz", "->", "200"}], ",", 
         RowBox[{"\[Omega]", "->", 
          RowBox[{"i", "*", "gran"}]}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"Last", "[", 
        RowBox[{"First", "[", "$Trajectories", "]"}], "]"}], "}"}], ",", 
      "3000", ",", " ", 
      RowBox[{"MaxSteps", "->", "Infinity"}], ",", " ", 
      RowBox[{"PlotPoints", "->", "500"}]}], "]"}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Data", " ", "Collection"}], " ", "*)"}], "\[IndentingNewLine]", 
    
    RowBox[{"vpeaks", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"$Trajectories", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"vvalleys", " ", "=", " ", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"$Trajectories", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ppeaks", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"$Trajectories", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"pvalleys", " ", "=", " ", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"$Trajectories", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"Vpeaks", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"i", "*", "gran"}], ",", "vpeaks"}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"Vvalleys", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"i", "*", "gran"}], ",", "vvalleys"}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"Ppeaks", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"i", "*", "gran"}], ",", "ppeaks"}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"Pvalleys", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"i", "*", "gran"}], ",", "pvalleys"}], "}"}]}], "]"}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"vmean", " ", "=", " ", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{"$Trajectories", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
